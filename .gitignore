# Local data and exact-reproduction archive (retain on your machine)
/data/
/originals/
*.rds
*.RData
*.rda
*.Rhistory
.Rproj.user/
.Renviron
.Renviron.*
.env
.env.*
*.pem
*.key
.DS_Store
__MACOSX/

# Generated technical notebooks and intermediate HTML assets
/01_data_prep.html
/02_spatial_analysis.html
/03_network_analysis.html
/04_portfolio.html
/*_files/
/*_cache/
/.quarto/

# Only selected publication outputs are tracked
/outputs/*
!/outputs/*.csv
!/outputs/session_info.txt
!/outputs/web/
/outputs/web/*
!/outputs/web/fig01_cycling_network.png
!/outputs/web/fig02_cross_river_flows.png
!/outputs/web/fig04_network_efficiency.png
